    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Itinerario", "url": "./index.html#/itinerario" },
    { "name": "Gastos", "url": "./index.html#/gastos" },
